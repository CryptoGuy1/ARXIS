# ── security: never commit credentials ───────────────────────────
retrain/token.json
token.json
*.token.json
client_secret*.json
credentials.json
.env

# ── virtual environments ─────────────────────────────────────────
.venv/
.venv-retrain/
venv/
env/

# ── python bytecode / build ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── large binaries: keep out of git, distribute via a release or DOI
*.pth
*.pt
*.joblib
*.npy
!models/model_config.json
# the autoencoder checkpoint is 59 KB, not a large binary, and `make check`
# cannot run without it from a bare clone
!models/lstm_autoencoder_weights.pth

# ── run outputs written to the repo root by main.py ──────────────
folder_live_test_log.csv
folder_live_test_summary.csv
folder_live_test_anomaly_sensitivity.csv
dashboard_folder_live_test_results.csv
output.log

# ── scratch / editor / OS ────────────────────────────────────────
.hermes-tmp.*
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── temporary test / smoke outputs ───────────────────────────────
*_smoke_*.py
*_smoke_*.log
*_inject_*.py
*_merge_*.py
*_exp3_derived.py
*_rerun.ps1

# ── thermal images (large binaries) ──────────────────────────────
# Written as dir/* rather than dir/ so the few frames the figures need can be
# re-included below; git will not look inside a directory excluded as dir/.
data/Mixture/*
data/NoGas/*
data/Smoke/*
data/Perfume/*
data/Thermal_Camera/
data/thermal_data/

# ── logs ──────────────────────────────────────────────────────────
*.log
retrain/results/*.log


# ── figure inputs: the four released thermal frames Fig. 1 is built from,
# and the single frame Fig. 3 shows, are tracked so `make figures` works
# from a clone. The rest of the image corpus stays out.
!data/NoGas/frame_NoGas.png
!data/Smoke/frame_Smoke.png
!data/Perfume/frame_Perfume.png
!data/Mixture/frame_Mixture.png
!data/Mixture/26_Mixture.png

# ── derived feature cache: regenerated by the pipeline, dropped by
# `make clean-cache`; tracking it would make that target dirty the tree
retrain/results/real_features.csv
retrain/results/real_features.csv.meta.json
retrain/results/real_features.csv.windows.npy

# ── the document build directory
build/

# ── built submission documents: `make docx` regenerates them byte-for-byte
# from the Markdown sources, and they are attached to the tagged release
*.docx
